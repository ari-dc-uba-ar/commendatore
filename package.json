{
  "name": "commendatore",
  "version": "0.0.4",
  "description": "Common way to build the command line of the tools: version on the first line, exit codes in the help, strict flags, --lang with i18n of the messages and confirmation of actions, on top of cleye",
  "author": "ari.dc.uba.ar",
  "license": "MIT",
  "type": "module",
  "main": "dist/commendatore.js",
  "types": "dist/commendatore.d.ts",
  "exports": {
    ".": {
      "types": "./dist/commendatore.d.ts",
      "default": "./dist/commendatore.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p test && mocha",
    "test-ci": "tsc -p test && c8 mocha"
  },
  "dependencies": {
    "cleye": "^2.7.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "mocha": "^12.0.3",
    "qa-control": "^0.12.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "cli",
    "cleye",
    "command-line"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ari-dc-uba-ar/commendatore.git"
  },
  "bugs": {
    "url": "https://github.com/ari-dc-uba-ar/commendatore/issues"
  },
  "homepage": "https://github.com/ari-dc-uba-ar/commendatore#readme",
  "qa-control": {
    "run-in": "server",
    "type": "lib",
    "gha": true
  }
}
